# ID do workspace no CRM que este número de WhatsApp pertence (ver tabela Workspace no banco).
WORKSPACE_ID=

# URL completa da rota de webhook do CRM que recebe status/mensagens deste serviço.
# Local: http://localhost:3000/api/webhooks/whatsapp-nao-oficial
# Produção: https://SEU-DOMINIO/api/webhooks/whatsapp-nao-oficial
CRM_WEBHOOK_URL=

# Segredo compartilhado entre este serviço e o CRM (gere com `openssl rand -hex 32`) — precisa ser
# EXATAMENTE o mesmo valor configurado em WHATSAPP_SERVICO_SEGREDO no .env do CRM.
SERVICO_SEGREDO=

# Porta HTTP deste serviço (Railway define PORT automaticamente — só mexa localmente).
PORT=3333

# Pasta onde as credenciais da sessão do WhatsApp ficam salvas — em produção precisa ser um volume
# persistente (ver README.md), senão a sessão some a cada deploy/restart e pede QR code de novo.
PASTA_SESSAO=./sessao
