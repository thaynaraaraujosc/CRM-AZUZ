// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Piloto de migração pra banco real. Espelha o tipo `Contato` de src/lib/data.ts.
// `id` continua String, mas a partir da Fase 2 do multi-tenancy passa a ser prefixado com o
// workspace (`${workspaceId}-${slugId(nome)}`, ver POST /api/contatos): sem isso, duas empresas
// com um contato de mesmo nome colidiriam na chave primária, que é global. `nome` deixa de ser
// único globalmente e vira único por workspace (`@@unique`).
model Contato {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  initials    String
  nome        String
  origem      String
  etapa       String
  responsavel String
  ultima      String
  valor       String

  email          String?
  whatsapp       String?
  nascimento     String?
  endereco       String?
  sobrenome      String?
  empresa        String?
  cargo          String?
  telefoneFixo   String?
  cidade         String?
  estado         String?
  pais           String?
  canalPreferido String?
  melhorHorario  String?

  // @ do Instagram (sem arroba). Preenchido sozinho quando a pessoa chega pelo Direct e o CRM
  // resolve o username na primeira mensagem. É o equivalente do `whatsapp` pro outro canal: sem
  // ele, um lead vindo do Direct virava contato sem nenhuma forma de reencontrar a pessoa.
  instagram String?
  /// IGSID: o identificador da pessoa dentro da conta conectada. É a chave ESTÁVEL do Instagram.
  ///
  /// O `instagram` acima é o @, e @ muda: a pessoa troca o nome de usuário e, deduplicando só por
  /// ele, a mesma pessoa volta a entrar como lead novo, com card novo, perdendo o histórico e
  /// enchendo o funil de duplicata. O IGSID não muda enquanto a conta existir. O @ continua sendo
  /// gravado porque é o que a equipe lê e procura; o IGSID é o que o CRM compara.
  instagramId String?
  /// Foto de perfil da pessoa, já baixada e guardada.
  ///
  /// Mora no CONTATO, não só na conversa, porque é a mesma pessoa em todo lugar: lista de
  /// conversas, funil, painel do funil, tela de contatos. Com a foto presa à conversa, o funil
  /// mostrava iniciais enquanto a conversa mostrava o rosto. O vendedor não reconhecia que era o
  /// mesmo lead.
  ///
  /// Guardada (não um link do CDN da Meta, que expira em horas) pelo mesmo motivo das miniaturas.
  fotoUrl   String? @db.Text

  // MySQL não tem array nativo. Etiquetas vira JSON (lista de strings) pra não inflar o
  // escopo do piloto com uma tabela relacionada agora.
  etiquetas Json?
  favorito  Boolean @default(false)

  // "manual" (criado por um usuário na tela de Contatos), "whatsapp" ou "instagram" (nasceu
  // sozinho quando uma mensagem nova chegou por aquele canal). Só rastreabilidade, não muda
  // nenhum comportamento.
  criadoVia String @default("manual")

  conversas          Conversa[]
  execucoesAutomacao ExecucaoAutomacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([workspaceId, nome])
}

// Uma "conversa" (thread de atendimento por canal). Nasce sozinha quando chega a primeira
// mensagem de um contato novo por um webhook conectado (WhatsApp oficial, WhatsApp via QR/Baileys
// ou Instagram). As mensagens em si continuam em `MensagemExtra`, casadas pelo mesmo `nome`: essa
// tabela só guarda o estado da thread (canal, status de atendimento, não lidas, favorita...).
model Conversa {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contatoId        String?
  contatoVinculado Contato? @relation(fields: [contatoId], references: [id])

  nome      String
  initials  String
  canal     String // "WhatsApp" | "Instagram" | "TikTok"
  contato   String? // telefone/@handle de exibição
  origem    String  @default("Direto")
  status    String  @default("Não respondido")
  naoLidas  Int     @default(0)
  favorita  Boolean @default(false)
  // Antes só existia como `Set` local no navegador (`useState`). Sumia a cada F5/login novo,
  // então uma conversa "arquivada" voltava a aparecer em "Tudo" sozinha, e a aba "Arquivadas" (que
  // só nasce quando tem pelo menos uma) sumia junto. Vira coluna real pelo mesmo motivo de
  // `favorita` acima: precisa sobreviver a atualizar a página.
  arquivada Boolean @default(false)

  atendenteSelecionado String?

  // Grupo de WhatsApp: sem isso, o webhook tratava cada mensagem de grupo como se fosse de um
  // contato individual (usava o nome de quem mandou como chave), então cada pessoa que falava no
  // mesmo grupo virava uma "conversa" separada em vez de tudo cair na thread do grupo. `nome` (a
  // coluna acima) já guarda o nome do grupo nesse caso; `contato` guarda o JID do grupo
  // (`<id>@g.us`): é essa dupla que identifica a thread, igual telefone identifica uma pessoa.
  ehGrupo            Boolean   @default(false)
  // Lista de participantes ({ nome, telefone }): buscada na Evolution API quando o grupo é visto
  // pela primeira vez (ver `buscarInfoGrupo`), null até a primeira busca ter sucesso.
  participantesGrupo Json?
  // Foto de perfil real (do WhatsApp). Grupo ou contato individual, buscada na Evolution API
  // (`buscarFotoPerfil`) quando a conversa é vista pela primeira vez. Null até a busca ter sucesso
  // (WhatsApp sem foto definida, ou busca falhou): nesse caso a tela cai pras iniciais como antes.
  fotoUrl            String?
  // Descrição do grupo (texto livre configurado no WhatsApp) e data real de criação DO GRUPO no
  // WhatsApp: não confundir com `criadoEm` abaixo, que é quando essa linha nasceu NESTE banco.
  // Ambos exibidos no painel "Dados do grupo" (clicar no cabeçalho da conversa), separado do painel
  // de participantes (que é outro clique, dentro desse).
  descricaoGrupo     String?   @db.Text
  criacaoGrupo       DateTime?

  // Conexão dona desta conversa: `<provedor>:<identificador do número>` (ex.:
  // `whatsapp_baileys:5562963404 38`, `meta_whatsapp:143588938831846`). Existe porque uma conversa
  // pertence a UM número conectado, não ao workspace inteiro: ao trocar de canal ou de número, a
  // caixa de entrada tem que zerar sem apagar nada. E voltar inteira se aquela conexão voltar.
  // Null = conversa anterior a esta coluna (tratada como do canal não oficial, ver
  // `contaCanalDaConexao`).
  contaCanal String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([workspaceId, nome])
  @@index([workspaceId, contaCanal])
}

// Núcleo comercial (2ª leva): espelha o tipo `Compromisso` de src/lib/agenda-context.tsx. Registro
// plano, sem aninhamento: só compromissos criados manualmente na Agenda (os derivados de Tarefa são
// calculados ao vivo no cliente por `compromissosDeTarefas`, nunca persistidos).
model Compromisso {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contatoId          String?
  contato            String
  responsavel        String
  dataIso            String
  hora               String
  horaFim            String?
  tipo               String
  categoria          String?
  descricao          String?
  local              String?
  status             String
  motivoCancelamento String?
  origem             String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Núcleo comercial (2ª leva): espelha `ColunaTarefas`/`TaskCard` de src/lib/data.ts. Etapas são
// editáveis pelo usuário (criar/renomear/reordenar/excluir em /tarefas), por isso viram tabela
// própria (não dá pra derivar só dos cards, porque uma etapa pode existir vazia). Excluir uma etapa
// remove os cards dela junto (mesmo comportamento que o Provider já tinha antes: `excluirEtapa`
// simplesmente descartava a coluna com o que tivesse dentro).
model TarefaEtapa {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo String
  ordem  Int
  cards  TarefaCard[]
}

model TarefaCard {
  id      String      @id
  etapaId String
  etapa   TarefaEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  ordem   Int

  // Denormalizado (não só via etapaId) pra toda rota conseguir checar posse do card direto, sem
  // precisar de um join até TarefaEtapa. Mesmo padrão usado em NegocioCard/FunilEtapa.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo              String
  contato             String
  contatoId           String?
  data                String
  atrasada            Boolean @default(false)
  responsavelNome     String
  responsavelInitials String
  concluida           Boolean @default(false)
  urgencia            String
  descricao           String
  anexoArquivo        String?
  anexoDetalhe        String?
  modelo              String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Multi-tenancy Fase 1: uma empresa que se cadastra no CRM. Cada Membro pertence a exatamente um
// Workspace; login é sempre "e-mail + senha dentro de um Workspace" (o e-mail do Membro é único
// globalmente, então não precisa desambiguar workspace no login).
model Workspace {
  id       String   @id
  nome     String
  // Fonte única de verdade pro segmento do negócio. Antes só existia dentro do blob de
  // `Preferencia` (chave "configuracoes"), desencontrado da coluna `nome` real e sem sobreviver
  // corretamente entre sessões/dispositivos. Null = ainda não preenchido pelo usuário.
  segmento String?
  slug     String   @unique
  criadoEm DateTime @default(now())

  membros Membro[]

  // Fase 2: back-relations exigidas pelo Prisma pra cada modelo de negócio que ganhou
  // workspaceId. Nenhuma é consultada a partir do Workspace no código (sempre se busca o modelo
  // filho direto, filtrado por workspaceId): só formalizam a relação nos dois lados do schema.
  contatos              Contato[]
  compromissos          Compromisso[]
  tarefaEtapas          TarefaEtapa[]
  tarefaCards           TarefaCard[]
  funis                 Funil[]
  funilEtapas           FunilEtapa[]
  negocioCards          NegocioCard[]
  preferencias          Preferencia[]
  mensagensExtra        MensagemExtra[]
  conversas             Conversa[]
  documentosBiblioteca  DocumentoBiblioteca[]
  formularios           Formulario[]
  respostasFormulario   RespostaFormulario[]
  fluxosAutomacao       FluxoAutomacao[]
  pastasAutomacao       PastaAutomacao[]
  gatilhosEtapa         GatilhoEtapa[]
  expediente            Expediente?
  documentos            Documento[]
  modelosPersonalizados ModeloPersonalizado[]
  integracoes           Integracao[]
  assinatura            Assinatura?
  acoesEnvio            AcaoEnvio[]
  motivosPerda          MotivoPerda[]
  relatoriosGerados     RelatorioGerado[]
  whatsappTemplates     WhatsappTemplate[]
  anexosPublicos        AnexoPublico[]
  arquivosArmazenados   ArquivoArmazenado[]
  instagramEventos      InstagramEvento[]
  automacaoExecucaos    AutomacaoExecucao[]
  versoesAutomacao      VersaoAutomacao[]
  execucoesAutomacao    ExecucaoAutomacao[]
  eventoDoLeads         EventoDoLead[]
  campanhas             Campanha[]
  templates             Template[]
}

// Núcleo comercial (2ª leva): espelha o tipo `Membro` de src/lib/data.ts. Segue o mesmo padrão de
// Contato: id continua o slug do front, email vira @unique (já era a chave de busca de convite).
// Multi-tenancy Fase 1: ganhou `workspaceId`: é a tabela real de autenticação agora, `senha` passa
// a guardar hash bcrypt (mesma coluna, conteúdo diferente, sem renomear pra não inflar o escopo).
model Membro {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  initials  String
  nome      String
  email     String  @unique
  senha     String?
  papel     String
  papelTipo String
  papelNota String?
  leads     String
  enxerga   String

  // MySQL não tem array nativo. Permissoes vira JSON (lista de strings).
  permissoes Json

  ativo           Boolean @default(true)
  convitePendente Boolean @default(false)
  // Foto hoje é gravada como data URL (base64 inline). Pode ficar grande, então usa TEXT em vez
  // do VARCHAR padrão.
  foto            String? @db.Text

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  ultimoAcesso DateTime?

  tokensRedefinicaoSenha TokenRedefinicaoSenha[]
  sessoesAtivas          SessaoAtiva[]
}

// Token de "esqueci minha senha". Mesmo espírito do token de convite (`/convite/[token]`), só que
// pra um Membro que já existe pedindo pra trocar a própria senha. `tokenHash` (não o token cru) é o
// que fica gravado, igual senha: o valor em texto puro só existe no link do e-mail, nunca no
// banco. Expira rápido (curto de propósito, é um link de e-mail) e só pode ser usado uma vez
// (`usadoEm` marca isso, evita reuso do mesmo link).
model TokenRedefinicaoSenha {
  id        String    @id
  membroId  String
  membro    Membro    @relation(fields: [membroId], references: [id])
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
}

// Sessão de login real: uma linha por login bem-sucedido (JWT carrega o `jti`, ver `src/lib/
// auth.ts`). Alimenta "Sessões ativas" em Configurações > Segurança com dispositivo/navegador de
// verdade (parseados do User-Agent no momento do login) em vez do mock anterior. `revogadaEm`
// marcado é conferido no callback `jwt` do NextAuth a cada request. Sessão revogada para de
// autenticar, então "Encerrar sessão" derruba o acesso de verdade, não só remove da lista.
model SessaoAtiva {
  id         String    @id
  membroId   String
  membro     Membro    @relation(fields: [membroId], references: [id])
  jti        String    @unique
  userAgent  String?
  ip         String?
  criadoEm   DateTime  @default(now())
  revogadaEm DateTime?

  @@index([membroId])
}

// Núcleo comercial (2ª leva, último módulo): espelha `Funil`/`ColunaFunil`/`NegocioCard` de
// src/lib/data.ts. Diferente de Contato/Membro/Compromisso/Tarefa, aqui NÃO existem mutadores
// dedicados no Context: o kanban de negócios (`funil/page.tsx`) e a tela de Funis em Configurações
// (`FunisSecao.tsx`) mexem direto em `setFunis` em ~13 lugares diferentes (criar/renomear/duplicar
// funil, criar/renomear/reordenar/excluir etapa, mover/criar negócio...). Reescrever cada um desses
// pontos pra chamar uma API própria multiplicaria o escopo dessa migração e arriscaria o kanban
// (a tela mais interativa do CRM). Por isso o Provider sincroniza o estado inteiro com o banco a cada
// mudança (`PUT /api/funis`, que reconcilia tudo numa transação). Mesmo espírito do `useEffect` que
// gravava tudo no localStorage antes, só que gravando de verdade.
model Funil {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome        String
  responsavel String?
  etapas      FunilEtapa[]
}

model FunilEtapa {
  id      String @id
  funilId String
  funil   Funil  @relation(fields: [funilId], references: [id], onDelete: Cascade)

  // Denormalizado (mesmo motivo de TarefaCard). O `PUT /api/funis` reconcilia a tabela inteira e
  // precisa filtrar o que apaga por workspace sem depender de join.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo   String
  ordem    Int
  cards    NegocioCard[]
  gatilhos GatilhoEtapa[]
}

model NegocioCard {
  id      String     @id
  etapaId String
  etapa   FunilEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  ordem   Int

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome        String
  valor       String
  origem      String
  dias        String
  data        String
  etiquetas   Json?
  responsavel String?

  // Estado de fechamento real do negócio. Null = ainda aberto (só a etapa/coluna descreve onde
  // está no funil). "ganho"/"perdido" grava o desfecho de verdade, é o que faz Inteligência
  // Comercial (conversão, motivo de perda, faturamento) calcular sobre dado real em vez de mock.
  statusFechamento String? // "ganho" | "perdido"
  motivoPerda      String?
  dataFechamento   DateTime?
  // Conexão que originou este negócio (`<provedor>:<identificador>`, mesmo formato de
  // `Conversa.contaCanal`). Existe pelo mesmo motivo: ao desconectar um canal, o funil precisa
  // parar de mostrar os negócios que vieram DELE. E mostrá-los de novo se aquela conexão voltar.
  // Nada é apagado: some da vista, continua no banco.
  //
  // Null = card criado à mão, ou anterior a esta coluna. Esses aparecem sempre: não pertencem a
  // conexão nenhuma, e sumir com eles seria esconder trabalho que a pessoa fez dentro do CRM.
  contaCanal       String?
}

// Motivos de perda configuráveis por workspace. Usados no seletor ao marcar um NegocioCard como
// "perdido" (ver src/app/(app)/funil/page.tsx) e nos indicadores de Inteligência Comercial. Cada
// workspace novo ganha um seed padrão na primeira vez que a tela é acessada (não em prisma/seed.ts,
// que só semeia o workspace de demonstração).
model MotivoPerda {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  nome        String
  criadoEm    DateTime  @default(now())

  @@unique([workspaceId, nome])
}

// Preferências simples (Notificações/Central do Dia/Configurações/Conversas-config). Cada Context
// não tem entidade própria, é um blob de preferências de UI, então vira uma linha só por Context
// identificada pela chave: a partir da Fase 2, uma linha por (workspace, chave), já que cada
// empresa tem sua própria configuração. Ver src/app/api/preferencias/[chave]/.
model Preferencia {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  chave String
  dados Json

  @@id([workspaceId, chave])
}

// Mensagens extras trocadas depois do seed (WhatsApp + popup de resposta rápida do Funil). Mesmo
// Record<contato, ConvMensagem[]> de src/lib/mensagens-extra-context.tsx, só que relacional (uma
// linha por mensagem, não um blob por contato) porque é uma lista naturalmente crescente. Os anexos
// (imagem/vídeo/documento/áudio/localização/contato compartilhado/citação) ficam em `extras`. Mesmo
// espírito de `etiquetas`/`permissoes` Json já usado no resto do schema.
model MensagemExtra {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contato      String
  tipo         String
  texto        String    @db.Text
  hora         String
  criadoEm     DateTime?
  status       String?
  extras       Json?
  // Canal de origem/destino da mensagem. Nulo = comportamento antigo (implicitamente Meta
  // oficial); "whatsapp_baileys" marca mensagens da conexão não oficial via QR Code, pra saber
  // por qual integração uma resposta deve sair quando o workspace tem as duas conectadas.
  canal        String?
  // Conexão dona desta mensagem: mesmo formato e mesmo motivo de `Conversa.contaCanal`. `canal`
  // acima diz só o tipo de conexão; este diz QUAL número, que é o que separa duas contas do mesmo
  // canal (a pessoa troca de número e a caixa de entrada precisa zerar).
  contaCanal   String?
  /// Id que a Meta gera pra mensagem que NÓS enviamos (`wamid`).
  ///
  /// É por ele que os webhooks de entrega/leitura encontram a mensagem certa: a Meta não conhece o
  /// id interno do CRM, ela só devolve o dela. Sem guardar isto, o webhook de status chegava,
  /// procurava a mensagem e não achava nada. Entregue e lido nunca saíam do lugar.
  ///
  /// Nulo em mensagem recebida (ali o próprio id JÁ é o wamid) e em canal que não devolve id.
  wamid        String?   @db.VarChar(191)
  /// Carimbo da última escrita nesta linha. Existe pra a tela poder perguntar "mudou alguma coisa?"
  /// com uma consulta barata (um MAX indexado) em vez de baixar o histórico inteiro a cada 5s.
  ///
  /// `criadoEm` sozinho não serve: mudança de status (enviado → entregue → lido) reescreve a linha
  /// sem criar linha nova, e a tela ficaria sem ver o visto azul. Nulo nas linhas anteriores a esta
  /// coluna: por isso a assinatura combina os dois carimbos e a contagem.
  atualizadoEm DateTime? @updatedAt

  @@index([workspaceId, criadoEm])
  @@index([workspaceId, atualizadoEm])
  @@index([workspaceId, contato])
  @@index([workspaceId, contaCanal])
  @@index([wamid])
}

// Biblioteca de mídia reutilizável pelos blocos de automação (enviar documento/imagem/vídeo/áudio).
model DocumentoBiblioteca {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome         String
  categoria    String
  formato      String
  tamanho      Int
  autor        String
  // Data URL: pode ser mídia grande, o TEXT padrão do MySQL (64KB) não é suficiente.
  url          String  @db.LongText
  tipoMidia    String?
  descricao    String?
  tags         Json?
  // ISO curto (aaaa-mm-dd) definido pelo front a cada mutação. Não é um timestamp gerenciado pelo
  // Prisma, por isso não é @updatedAt.
  atualizadoEm String
}

// Form builder: páginas/perguntas/tema/versões ficam como Json na própria linha do formulário
// porque os mutadores de src/lib/formularios-context.tsx sempre recalculam o array inteiro e
// substituem (nunca endereçam página/pergunta por id numa API própria).
model Formulario {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome         String
  descricao    String?
  status       String
  paginas      Json
  paginaFinal  Json
  tema         Json
  senha        String?
  integracoes  Json?
  versoes      Json
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Respostas de formulário: lista naturalmente crescente (igual Compromisso/TarefaCard), tabela
// própria em vez de Json na linha do Formulario. `workspaceId` aqui NUNCA vem de uma sessão (quem
// responde é um lead público, sem login): é copiado do Formulario pai no momento da criação, em
// POST /api/formularios/[id]/respostas.
model RespostaFormulario {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  formularioId String
  criadoEm     DateTime @default(now())
  valores      Json
}

// Motor de fluxo de automação (visual, nodes/edges): mesmo raciocínio de Formulario: os mutadores
// de src/lib/automation-flow-context.tsx sempre recalculam nodes/edges/configuracoes/historicoVersoes
// inteiros. Log de execução continua só em memória (nunca persistiu, sem mudança de comportamento).
/// Pasta de automações. Uma lista com trinta robôs sem forma de agrupar é uma lista que ninguém
/// lê: a pessoa perde mais tempo procurando "aquele do comentário" do que editando.
///
/// Só um nível, de propósito. Pasta dentro de pasta resolve um problema que ninguém tem aqui e
/// cria outro que todo mundo tem: não achar mais onde as coisas foram parar. Apagar a pasta NÃO
/// apaga os robôs (`onDelete: SetNull`): eles voltam pra raiz.
model PastaAutomacao {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome String
  /// "comercial" | "social": a pasta pertence a uma área, como o fluxo.
  area String @default("social")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  fluxos FluxoAutomacao[]

  @@index([workspaceId, area])
}

model FluxoAutomacao {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome               String
  /// "comercial" (funil, WhatsApp, e-mail) ou "social" (Instagram). NÃO é um motor diferente: o
  /// motor, as execuções e o versionamento são os mesmos. A área diz quais canais estão em jogo e,
  /// portanto, quais blocos fazem sentido oferecer no construtor. O padrão é comercial porque todo
  /// fluxo que já existe é comercial.
  area               String    @default("comercial")
  /// Pasta em que o robô está guardado, quando está em alguma. Nulo = na raiz.
  pastaId            String?
  pasta              PastaAutomacao? @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  // Texto livre: alguns fluxos de demonstração passam de 191 caracteres (VARCHAR padrão), por
  // isso @db.Text (mesmo motivo do `objetivo` abaixo).
  descricao          String?   @db.Text
  funilId            String?
  etapaId            String?
  categoria          String?
  status             String
  ativa              Boolean   @default(false)
  nodes              Json
  edges              Json
  versaoAtual        Int
  configuracoes      Json
  execucoes          Int       @default(0)
  historicoVersoes   Json
  publicadoEm        DateTime?
  publicadoPor       String?
  arquivada          Boolean   @default(false)
  modeloDemonstracao Boolean   @default(false)
  objetivo           String?   @db.Text
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  /// Publicações e execuções: ver `VersaoAutomacao` e `ExecucaoAutomacao`. `historicoVersoes`
  /// (Json acima) continua existindo enquanto a migração roda; a fonte da verdade passa a ser a
  /// tabela.
  versoes              VersaoAutomacao[]
  execucoesEmAndamento ExecucaoAutomacao[]
}

// Editor de documentos (rich-text): mesmo raciocínio: páginas/comentários/versões/acessos/config
// ficam como Json na linha do documento (mutadores de src/lib/documentos-context.tsx sempre
// recalculam o array inteiro). "Favoritos"/"recentes" de modelo (localStorage puro hoje, listas de
// id de navegação, não conteúdo dono) continuam fora do banco. Mesmo precedente de
// "azuz-crm-documentos-prefs-ver", que já não fazia parte do Context.
model Documento {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo        String
  favorito      Boolean  @default(false)
  autor         String
  paginas       Json
  config        Json
  pessoasAcesso Json
  linkAtivo     Boolean  @default(false)
  linkPermissao String?
  comentarios   Json
  versoes       Json
  excluido      Boolean  @default(false)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

model ModeloPersonalizado {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome          String
  descricao     String   @db.Text
  categoria     String
  // HTML do conteúdo do documento. Pode ser grande, TEXT padrão (64KB) não é suficiente.
  conteudoHtml  String   @db.LongText
  compartilhado Boolean  @default(false)
  autor         String
  criadoEm      DateTime @default(now())
}

// Integrações oficiais (Fase A): uma linha por (workspace, provedor). Começa só com
// "meta_whatsapp"; Instagram/Meta Ads/Google Ads entram como novos valores de `provedor` nas
// próximas fases, reaproveitando o mesmo modelo. Tokens nunca ficam em texto puro. Ver
// src/lib/integracoes/crypto.ts (AES-256-GCM, diferente do bcrypt do login: aqui o token precisa
// ser usado de novo depois, não só verificado).
model Integracao {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  provedor String // "meta_whatsapp"
  status   String // "desconectado" | "conectado" | "erro"

  accessTokenCriptografado  String?   @db.Text
  refreshTokenCriptografado String?   @db.Text
  expiraEm                  DateTime?

  // Dados específicos do provedor (ex.: phoneNumberId/wabaId da Meta): cada provedor usa um
  // subconjunto de chaves diferentes, por isso Json em vez de colunas fixas.
  metadados    Json?
  erroMensagem String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([workspaceId, provedor])
}

// Assinatura do próprio CRM (cobrança da mensalidade do workspace via Asaas). Não confundir com
// `Integracao`: aqui não é o cliente conectando a conta Asaas dele, é a Azuz cobrando o cliente
// pela conta Asaas da própria Azuz. Uma linha por workspace (1:1). O histórico de cobranças não é
// espelhado no banco: é buscado ao vivo na Asaas (`GET /subscriptions/{id}/payments`) pra nunca
// dessincronizar; aqui só fica o suficiente pra saber o status atual sem chamar a API a cada
// carregamento de tela.
model Assinatura {
  id          String    @id
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  plano String // "completo". Plano único do CRM, ver src/lib/assinatura/planos.ts
  valor Decimal @db.Decimal(10, 2)

  status String // "pendente" | "ativa" | "atrasada" | "cancelada"

  asaasCustomerId     String
  asaasSubscriptionId String?
  formaPagamento      String? // "BOLETO" | "CREDIT_CARD" | "PIX"

  proximoVencimento DateTime?
  canceladaEm       DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Ações (item 7 do pedido de novas demandas). Lista de transmissão agendada/enviada, tela
// "Ações". Antes o histórico inteiro (inclusive "Dia Mundial do Diabetes", "Reativação"...) era
// mock fixo em src/lib/data.ts, e "Agendar envio" só empilhava em memória (sumia no F5). Guarda só
// o registro da ação em si. O disparo de verdade pros contatos (via WhatsApp/Instagram/SMS) ainda
// não existe (precisaria de um agendador/fila rodando fora do request, fora do escopo agora); por
// enquanto fica marcado como "Agendado" e é isso.
/// OBSOLETO. Era o registro de "Ações" antes de existir o disparo de verdade (`Campanha`); a tela
/// e a rota que usavam isto foram removidas. O modelo fica só pra tabela não ser derrubada num
/// deploy sem alguém confirmar que está vazia (`db push` sem `--accept-data-loss` recusaria e
/// travaria a publicação). Passo seguinte: confirmar zero linhas em produção e apagar daqui.
model AcaoEnvio {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo       String
  legenda      String?  @db.Text
  midiaTipo    String // "imagem" | "audio" | "texto"
  canais       Json // string[]: "WhatsApp" | "Instagram" | "E-mail" | "SMS"
  agendadoPara DateTime
  // Snapshot dos nomes dos contatos no momento da criação. Não é uma relação de verdade porque
  // Contato não tem id estável o suficiente pra isso ainda (mesmo padrão já aceito em outras
  // tabelas desta fase, ver `TarefaCard.contato`).
  contatos     Json // string[]

  criadoEm DateTime @default(now())
}

// Histórico de relatórios já gerados (Central de Relatórios). Antes só vivia no localStorage do
// navegador (não sobrevivia a trocar de dispositivo, e conta nova começava com 3 relatórios de
// exemplo fictícios). Só cria (histórico é sempre apêndice, nunca editado): GET lista, POST
// adiciona um novo registro.
model RelatorioGerado {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome         String
  tipo         String
  contato      String?
  periodo      String
  filtros      String
  autor        String
  paginas      Int
  formato      String
  configuracao Json

  criadoEm DateTime @default(now())
}

// Modelo de mensagem (template) do WhatsApp Business oficial. Cada WABA tem os próprios, não
// existe template global. Nasce como espelho local do que existe na Graph API (criado por lá ou
// por aqui), pra não precisar fazer polling: a aprovação/rejeição chega pelo webhook
// `message_template_status_update` e atualiza esse registro na hora.
model WhatsappTemplate {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  metaId         String // id do template na Graph API
  wabaId         String
  nome           String
  idioma         String
  categoria      String // MARKETING | UTILITY | AUTHENTICATION
  status         String // PENDING | APPROVED | REJECTED | PAUSED
  motivoRejeicao String?
  componentes    Json

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([workspaceId, metaId])
  @@index([workspaceId])
}

// Arquivo exposto por um link público, assinado e de vida curta. Existe só pra a Meta conseguir
// buscá-lo.
//
// Mandar anexo pelo Direct do Instagram não aceita o arquivo no corpo da requisição: a API recebe
// um ENDEREÇO e vai buscar o conteúdo ela mesma, de fora. Todas as rotas de mídia do CRM exigem
// sessão, então a Meta batia numa porta fechada. Esta tabela guarda o arquivo por pouco tempo e o
// serve num endereço que não pede login, mas exige uma assinatura e expira. É o mínimo de
// exposição que faz o envio funcionar.
model AnexoPublico {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome     String
  mimeType String
  // Base64 do arquivo (sem o prefixo `data:`). LongText porque o TEXT padrão do MySQL (64KB) não
  // serve nem pra um PDF pequeno.
  conteudo String @db.LongText

  // Passado disso o link para de responder. Curto de propósito: a Meta busca o arquivo em
  // segundos, logo depois do envio; deixar aberto por dias só aumentaria a janela de exposição.
  expiraEm DateTime

  criadoEm DateTime @default(now())

  @@index([expiraEm])
}

/// Um arquivo guardado no Cloudflare R2.
///
/// O arquivo em si NÃO está aqui. No banco fica só o registro dele. Existe por dois motivos:
/// somar o espaço usado por workspace sem precisar varrer o bucket inteiro (o R2 cobra por
/// listagem, e um cliente com anos de conversa tem dezenas de milhares de objetos), e saber o que
/// apagar quando um cliente sai, sem tocar no arquivo de ninguém.
model ArquivoArmazenado {
  /// Caminho do objeto dentro do bucket (`<workspaceId>/<ano>/<mes>/<id>.<ext>`).
  chave String @id @db.VarChar(255)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  bytes    Int
  mimeType String

  /// De onde veio: "mensagem" (anexo de conversa) ou "envio" (arquivo publicado pra Meta buscar).
  origem String

  criadoEm DateTime @default(now())

  @@index([workspaceId])
}

/// Evento do Instagram, já normalizado: a camada que separa o CRM do formato cru da Meta.
///
/// Por que existe: até aqui o webhook lia o corpo da Meta e gravava direto em `MensagemExtra`.
/// Funcionava pro Direct, mas amarrava o CRM inteiro ao formato dela: todo evento novo (comentário,
/// menção, resposta a comentário) exigiria espalhar o conhecimento do payload por mais lugares, e
/// nada que não fosse "mensagem" tinha onde ser guardado.
///
/// Agora o webhook só traduz; quem consome lê daqui. A tradução é o único ponto do sistema que
/// precisa saber como a Meta nomeia as coisas.
///
/// O `id` é a chave natural do evento na Meta (o `mid` da mensagem, o id do comentário). Como é
/// chave primária, um webhook reenviado: coisa que a Meta faz rotineiramente. Falha ao gravar em
/// vez de duplicar. A deduplicação não depende de ninguém lembrar de checar.
model InstagramEvento {
  id String @id @db.VarChar(191)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// IGSID da conta conectada que recebeu o evento. Separa duas contas do mesmo workspace.
  contaInstagramId String

  /// Tipo normalizado: mensagem_recebida, mensagem_enviada, midia_recebida, story_respondido,
  /// publicacao_compartilhada, reacao_adicionada, reacao_removida, comentario_criado,
  /// resposta_comentario, mencao. Nome do CRM, não da Meta.
  tipo String

  /// Chave da conversa/contato no CRM (o @ quando conhecido, senão o IGSID).
  contatoNome String?

  remetenteId       String?
  remetenteUsername String?

  mensagemId      String?
  midiaId         String?
  comentarioId    String?
  comentarioPaiId String?
  permalink       String? @db.Text

  texto String? @db.Text

  /// O que não cabe nas colunas: tipo de mídia, emoji da reação, payload extra. Consultar por
  /// coluna é o caminho normal; isto é a folga pro que aparecer depois sem migração.
  dados Json?

  /// Processado com sucesso pelo pipeline (persistência + automações). Falso = ficou pendente e
  /// pode ser reprocessado sem risco, já que a gravação é idempotente.
  processado Boolean @default(false)
  erro       String? @db.Text

  criadoEm DateTime @default(now())

  @@index([workspaceId, criadoEm])
  @@index([workspaceId, tipo])
  @@index([workspaceId, contatoNome])
  @@index([comentarioId])
}

/// Uma automação que já rodou para um evento. A trava contra disparo repetido.
///
/// Sem isso, o mesmo comentário podia executar o mesmo fluxo várias vezes: a Meta reenvia webhook,
/// e do lado de cá cada reenvio parecia um comentário novo. Na prática o cliente receberia a mesma
/// resposta duas, três vezes.
///
/// A unicidade é (fluxo, evento): o mesmo comentário PODE disparar fluxos diferentes, o que é
/// desejado, mas nunca o mesmo fluxo duas vezes.
model AutomacaoExecucao {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  fluxoId String

  /// Identificador do que disparou: "comentario:<id>", "mensagem:<mid>", "reacao:<mid>".
  chaveEvento String @db.VarChar(191)

  /// Quem era a pessoa do outro lado. Útil pra investigar disparo indevido depois.
  instagramUserId String?

  executadoEm DateTime @default(now())

  @@unique([fluxoId, chaveEvento])
  @@index([workspaceId, executadoEm])
}

/// Linha do tempo do lead. O histórico legível de tudo que aconteceu com um contato.
///
/// Serve a duas coisas: o atendente entender o contexto sem reconstruir a história na cabeça, e a
/// Inteligência Comercial / IA receberem esse contexto já estruturado, em vez de terem que inferir
/// a partir de mensagens soltas.
/// Uma PUBLICAÇÃO de uma automação. Hoje as versões vivem dentro de `FluxoAutomacao.historicoVersoes`
/// (um Json que cresce sem limite e não dá pra consultar); aqui cada publicação é uma linha, e é o
/// que uma execução aponta.
///
/// POR QUE ISTO IMPORTA: hoje o servidor executa `FluxoAutomacao.nodes`, que é o RASCUNHO. Quem
/// está editando o fluxo no navegador muda, sem querer, o que está rodando pros leads naquele
/// instante. Com a versão numa linha própria, o que roda é o que foi publicado, e um lead que
/// começou na v3 termina na v3 mesmo que a v4 seja publicada no meio.
model VersaoAutomacao {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  fluxoId String
  fluxo   FluxoAutomacao @relation(fields: [fluxoId], references: [id], onDelete: Cascade)

  versao        Int
  nodes         Json
  edges         Json
  configuracoes Json

  publicadoEm  DateTime @default(now())
  publicadoPor String?

  execucoes ExecucaoAutomacao[]

  /// A mesma versão nunca é publicada duas vezes pro mesmo fluxo.
  @@unique([fluxoId, versao])
  @@index([workspaceId, fluxoId])
}

/// Uma automação RODANDO para UM contato. É a peça que hoje não existe: o motor atual roda o fluxo
/// inteiro numa chamada e joga fora o resultado, então "aguardar 2 horas" simplesmente descarta a
/// execução. Com esta linha, o estado vive no banco: qual nó é o próximo, o que já se sabe do
/// contato, e o que a execução está esperando.
///
/// Como a execução volta a andar, os dois únicos caminhos:
/// - TEMPO: `aguardandoAte` no passado e o cron pega (mesmo padrão do disparo em massa).
/// - EVENTO: o webhook de mensagem procura execução `aguardando_evento` daquele contato ANTES de
///   avaliar gatilhos novos: é isso que faz "clicou em Sim" continuar o fluxo em vez de começar
///   outro.
model ExecucaoAutomacao {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  fluxoId String
  fluxo   FluxoAutomacao @relation(fields: [fluxoId], references: [id], onDelete: Cascade)

  /// A versão publicada que esta execução está rodando. Congelada no início.
  versaoId String?
  versao   VersaoAutomacao? @relation(fields: [versaoId], references: [id])

  /// Quem está no fluxo. `contatoId` é a identidade de verdade; `contatoNome` fica junto porque é
  /// a chave que Conversa/MensagemExtra ainda usam, e o motor precisa das duas até a migração
  /// terminar.
  contatoId   String?
  contato     Contato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  contatoNome String

  /// O que começou tudo: "mensagem_recebida", "lead_entrou_etapa"…
  gatilho String

  /// em_andamento | aguardando_tempo | aguardando_evento | concluida | cancelada | erro
  situacao String @default("em_andamento")

  /// Próximo nó a executar. Nulo quando terminou.
  noAtualId String?

  /// O que o motor sabe do contato e do que já aconteceu (respostas, valores lidos). É o "contexto"
  /// que hoje só existe em memória durante a chamada.
  contexto Json?

  /// Quando o cron deve retomar (espera por tempo).
  aguardandoAte    DateTime?
  /// O que retoma esta execução: "resposta", "clique", "formulario"… com o nó que espera.
  aguardandoEvento String?
  aguardandoNoId   String?

  /// Última mensagem de erro legível, quando `situacao = erro`.
  erroMensagem String? @db.Text

  iniciadaEm   DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  finalizadaEm DateTime?

  passos PassoAutomacao[]

  /// A varredura do cron: o que está esperando tempo e já venceu.
  @@index([situacao, aguardandoAte])
  /// A correlação por evento: execução aguardando daquele contato, a mais recente primeiro.
  @@index([workspaceId, contatoNome, situacao])
  @@index([workspaceId, fluxoId, iniciadaEm])
}

/// O log de UM nó dentro de uma execução. É o "Histórico de execuções" que hoje não existe (o
/// motor só imprime `console.log` com a contagem de passos).
///
/// Guarda o erro em duas camadas de propósito: `detalhe` é o que a pessoa lê na tela ("Template não
/// aprovado"), `erroTecnico` é o que serve pra investigar (código da Meta, corpo do erro). Nunca
/// credencial: o que entra aqui é mensagem de erro, não token.
model PassoAutomacao {
  id         String            @id
  execucaoId String
  execucao   ExecucaoAutomacao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  /// Repetido aqui pra consultar log por workspace sem entrar na execução.
  workspaceId String

  noId   String
  noTipo String
  titulo String?

  /// ok | condicao_falsa | aguardando | erro | pulado
  resultado   String
  detalhe     String? @db.Text
  erroTecnico String? @db.Text

  /// Quantas vezes este nó já foi tentado nesta execução (retry).
  tentativa Int @default(1)

  criadoEm DateTime @default(now())

  @@index([execucaoId, criadoEm])
  @@index([workspaceId, criadoEm])
}

model EventoDoLead {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// Mesma chave usada em `Conversa.nome` e `MensagemExtra.contato`.
  contatoNome String

  canal String

  /// comentou, automacao_iniciou, respondeu_comentario, enviou_direct, respondeu_direct,
  /// entrou_no_funil, mudou_de_etapa, etiqueta_adicionada, atendente_assumiu, reagiu.
  tipo String

  /// Frase pronta pra exibir ("comentou 'quero' no Reel X").
  descricao String @db.Text

  dados Json?

  criadoEm DateTime @default(now())

  @@index([workspaceId, contatoNome, criadoEm])
}

// ============================================================================
// Campanhas (Disparo em massa)
//
// `AcaoEnvio` acima guarda só o registro da ação e nunca enviou nada. A tela dizia "Envio
// agendado" e a mensagem não saía. Estes dois modelos são o disparo de verdade.
//
// Duas tabelas, e a separação é o que sustenta tudo o mais: a campanha é a intenção, o
// destinatário é o trabalho. Cada pessoa vira UMA linha gravada ANTES de qualquer envio, com
// estado próprio. É isso que dá, sem truque nenhum:
//   - idempotência: clicar duas vezes não cria destinatário duas vezes (`@@unique`);
//   - retomada: worker que morreu no meio recomeça de onde parou, porque o estado está no banco;
//   - rastreio individual: dá pra dizer o que aconteceu com CADA contato, e por quê;
//   - ritmo: o worker pega só o que cabe na janela, em vez de despejar tudo de uma vez.
// ============================================================================

model Campanha {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  titulo  String
  /// Texto da mensagem. Em e-mail é o corpo; no WhatsApp é a mensagem em si.
  corpo   String  @db.Text
  /// Assunto: só e-mail usa.
  assunto String?

  /// "whatsapp_oficial" | "whatsapp_nao_oficial" | "email". Um canal por campanha, de propósito:
  /// cada um tem ritmo, limite e regra de conteúdo diferentes, e misturar os três numa campanha só
  /// faria o relatório dizer "80% entregue" sobre coisas que nem são comparáveis.
  canal String

  /// Modelo aprovado da Meta, obrigatório no WhatsApp oficial quando a janela de 24h está fechada.
  templateNome   String?
  templateIdioma String?
  /// Template do CRM (tabela `Template`) de onde a mensagem saiu, quando saiu de um. Guardado por
  /// id pra tela de acompanhamento mostrar "Template: Retomar atendimento" mesmo que o texto mude.
  templateId     String?
  /// Como cada variável da mensagem é preenchida: `[{ chave: "nome", indice: 1, origem: "contato.nome" }]`.
  /// O valor por destinatário é resolvido NA CRIAÇÃO e congelado em `CampanhaDestinatario.parametros`,
  /// pelo mesmo motivo do `destino`. Ver `src/lib/campanhas/variaveis.ts`.
  variaveis      Json?
  /// Como o público foi escolhido (`{ modo: "etiqueta", valor: "vip" }`…), só pra reexibir na tela
  /// de acompanhamento. Quem recebe de verdade está em `destinatarios`.
  audiencia      Json?

  /// agendada | enviando | pausada | concluida | concluida_com_erros | cancelada
  status String @default("agendada")

  /// Quando começar. Agora = data no passado; agendamento = data futura. Quem decide é o worker,
  /// então fechar o navegador não muda nada.
  agendadaPara DateTime

  iniciadaEm  DateTime?
  concluidaEm DateTime?

  /// Erro que interrompeu a campanha inteira (canal desconectado, token morto). Falha de UM
  /// destinatário não vem pra cá. Fica na linha dele.
  erroMensagem String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  destinatarios CampanhaDestinatario[]

  @@index([workspaceId, criadoEm])
  /// O worker varre por aqui: só campanhas de um status, prontas pra rodar.
  @@index([status, agendadaPara])
}

/// Mensagem reutilizável do CRM: o que o Disparo em massa e, depois, o construtor de automações
/// escolhem. NÃO substitui `WhatsappTemplate`: aquele é o espelho do que existe na Meta; este é o
/// que a pessoa escreve aqui, em qualquer canal. No WhatsApp oficial os dois se ligam por
/// `whatsappTemplateId` quando o template é enviado pra análise.
///
/// Variáveis são NOMEADAS (`{{nome}}`), porque é assim que uma pessoa escreve. A Meta exige
/// numeradas (`{{1}}`); a conversão acontece na hora de enviar pra análise, e `variaveis` guarda
/// o índice de cada uma pra manter o vínculo (ver `src/lib/campanhas/variaveis.ts`).
model Template {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  nome      String
  /// "whatsapp_oficial" | "whatsapp_nao_oficial" | "email"
  canal     String
  /// Só o WhatsApp oficial exige: MARKETING | UTILITY | AUTHENTICATION.
  categoria String?
  idioma    String  @default("pt_BR")
  /// Só e-mail usa.
  assunto   String?
  corpo     String  @db.Text
  /// `[{ chave: "nome", indice: 1, origem: "contato.nome" }]`: o mapeamento padrão de cada variável.
  variaveis Json?
  /// `[{ texto: "Sim, quero continuar" }]`: botões de resposta rápida, com o limite do canal
  /// aplicado na gravação (ver `limitesDoCanal`).
  botoes    Json?

  /// rascunho | em_analise | aprovado | rejeitado. Canal sem análise (QR, e-mail) vai direto pra
  /// "aprovado" ao salvar: o status existe pra tela ser uma só, não pra fingir um processo.
  status             String  @default("rascunho")
  motivoRejeicao     String? @db.Text
  /// Espelho na Meta (`WhatsappTemplate.id`), preenchido quando enviado pra análise.
  whatsappTemplateId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([workspaceId, canal])
}

model CampanhaDestinatario {
  id         String   @id
  campanhaId String
  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  /// Repetido aqui de propósito: o worker filtra e conta por workspace sem precisar entrar na
  /// campanha, e é o que permite limitar concorrência por cliente.
  workspaceId String

  /// Nome do contato no CRM. A mesma chave usada em `Conversa.nome` e `MensagemExtra.contato`.
  contatoNome String
  /// Para onde vai de verdade, resolvido NA CRIAÇÃO da campanha e congelado aqui. Não pode ser
  /// buscado na hora do envio: o contato pode ser editado ou apagado no meio de uma campanha de
  /// vários dias, e aí a mensagem iria pro lugar errado. Ou pra lugar nenhum.
  destino     String

  /// pendente | enviando | enviado | entregue | lido | falhou | cancelado
  status String @default("pendente")

  /// Id que o provedor devolve (`wamid` no WhatsApp oficial, id do Resend no e-mail). É por ele
  /// que o webhook de status encontra esta linha depois.
  idExterno String? @db.VarChar(191)

  tentativas   Int       @default(0)
  erroMensagem String?   @db.Text
  enviadoEm    DateTime?
  /// Marcos que o webhook de status do WhatsApp oficial preenche casando pelo `idExterno`
  /// (`wamid`). `respondidoEm` é preenchido quando a pessoa manda qualquer mensagem depois do envio.
  entregueEm   DateTime?
  lidoEm       DateTime?
  respondidoEm DateTime?
  /// Valores das variáveis PARA ESTA PESSOA (`{ nome: "Maria", produto: "Plano X" }`), resolvidos na
  /// criação da campanha. O worker só substitui; nunca consulta o contato na hora do envio.
  parametros   Json?

  criadoEm DateTime @default(now())

  /// Idempotência de verdade: a mesma pessoa não entra duas vezes na mesma campanha, nem que o
  /// botão seja clicado dez vezes ou que a criação seja repetida por timeout.
  @@unique([campanhaId, contatoNome])
  /// A varredura do worker: próximos pendentes de uma campanha, na ordem de criação.
  @@index([campanhaId, status])
  @@index([workspaceId, status])
}

/**
 * Gatilho preso a uma ETAPA do funil: "quando o lead entra nesta etapa, execute o robô X".
 * A automação passa a ser vista de onde ela acontece. Antes o gatilho morava dentro do fluxo, o
 * que escondia do quadro do funil quais etapas fazem alguma coisa sozinhas: pra saber, era preciso
 * abrir automação por automação. Aqui a etapa é a dona do gatilho, e o fluxo vira um robô
 * reutilizável que várias etapas podem executar.
 * Não substitui o gatilho de dentro do fluxo: os dois convivem. Fluxos que já existem continuam
 * disparando pelo bloco de gatilho deles.
 */
model GatilhoEtapa {
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  funilId String
  etapaId String
  etapa   FunilEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  // "movido" | "criado" | "movido_ou_criado" | "responsavel_alterado" | "diariamente"
  quando String

  // O QUE a etapa faz. "robo" executa um fluxo; os outros são ações diretas, sem robô no meio,
  // que é como o Kommo deixa uma etapa trocar o responsável ou marcar uma tarefa sozinha.
  // "robo" | "responsavel" | "etapa" | "etiquetas" | "tarefa" | "webhook" | "mensagem"
  tipoAcao String @default("robo")

  // O robô que roda, quando tipoAcao = "robo". Nulo nas ações diretas.
  fluxoId String?

  // Parâmetros da ação direta: o responsável escolhido, a etapa de destino, as etiquetas, o
  // texto da tarefa, o endereço do webhook. Formato depende do tipoAcao.
  acaoDados Json?

  // Condição extra ("Para todos os leads com:"), no mesmo formato do bloco de condição do editor.
  condicao Json?

  // Janela em que o gatilho vale. Lista vazia/ausente = todos os dias. Horas em "HH:MM".
  // Fora da janela o gatilho não dispara: é o "Ativo: sempre" do Kommo com dias e horário.
  diasAtivos Json?
  horaInicio String?
  horaFim    String?

  // Só pro quando = "diariamente": a que horas a varredura roda ("12:00").
  horarioDiario String?

  ativo Boolean @default(true)
  ordem Int     @default(0)

  criadoEm DateTime @default(now())

  @@index([workspaceId, etapaId])
  @@index([workspaceId, funilId])
}

/**
 * O horário de funcionamento do workspace. Uma linha por workspace.
 * Existe pra ser reutilizado: pausa de automação, follow-up e gatilho de etapa precisam da mesma
 * resposta pra "estamos abertos agora?". Sem um lugar só, cada um teria a própria configuração e
 * elas divergiriam: o follow-up de duas horas dispararia às três da manhã enquanto o gatilho
 * respeitava o comercial.
 */
model Expediente {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  /// Por dia da semana: 1 = segunda … 7 = domingo. Dia ausente = fechado.
  /// Formato: { "1": { "de": "08:00", "ate": "18:00" }, "6": { "de": "08:00", "ate": "12:00" } }
  dias Json

  /// Fuso do workspace. "America/Sao_Paulo" enquanto todo mundo é do Brasil, mas guardado porque
  /// um cliente em outro fuso faria toda a conta de horário errar em silêncio.
  fuso String @default("America/Sao_Paulo")

  atualizadoEm DateTime @updatedAt
}
