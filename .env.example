# Copie para .env e preencha com a connection string real do banco (Railway > serviço MySQL > aba Variables).
DATABASE_URL="mysql://usuario:senha@host:porta/banco"

# WhatsApp não oficial (Baileys) — ver whatsapp-service/README.md. WHATSAPP_SERVICO_SEGREDO precisa
# ser IDÊNTICO ao SERVICO_SEGREDO configurado no .env do whatsapp-service.
WHATSAPP_SERVICO_SEGREDO=
WHATSAPP_SERVICO_URL=http://localhost:3333

# Assinatura do CRM via Asaas (cobrança da mensalidade do workspace, não é integração de cliente).
# ASAAS_ENV = "sandbox" (padrão, chave começa com $aact_hmlg_) ou "production" (chave $aact_prod_).
# ASAAS_API_KEY = chave de API gerada em asaas.com > Integrações > API.
# ASAAS_WALLET_ID = id da carteira Asaas (não usado nas chamadas atuais, guardado pra split de
#   pagamento futuro, se vier a existir).
# ASAAS_WEBHOOK_TOKEN = valor escolhido por você, cadastrado igual em Configurações > Integrações >
#   Webhooks no painel da Asaas — a Asaas devolve esse valor no header `asaas-access-token` de todo
#   webhook, é assim que a rota confirma que a chamada é mesmo da Asaas.
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_TOKEN="escolha-um-valor-aleatorio-longo"

# E-mail transacional da plataforma (recuperação de senha, ver src/lib/email.ts) — via Resend.
# RESEND_API_KEY = chave gerada em resend.com > API Keys.
# EMAIL_FROM = remetente ("Nome <endereco@dominio>"); sem domínio verificado no Resend, use
#   "CRM AZUZ <onboarding@resend.dev>" (funciona de graça, só não deixa customizar o domínio).
RESEND_API_KEY=""
EMAIL_FROM="CRM AZUZ <onboarding@resend.dev>"

# Painel de super-admin (/admin) — visão cross-tenant de todos os workspaces, uso interno da Azuz.
# SUPERADMIN_EMAIL = e-mail de um Membro que já existe em algum workspace (a senha continua sendo a
#   dele, cadastrada normalmente) — ao logar com esse e-mail, cai direto no /admin em vez do painel
#   normal do workspace. Só um e-mail; qualquer outro Membro continua vendo só o próprio workspace.
SUPERADMIN_EMAIL="thaynaraaraujosc@gmail.com"
