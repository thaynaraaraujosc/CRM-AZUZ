# Copie para .env e preencha com a connection string real do banco (Railway > serviço MySQL > aba Variables).
DATABASE_URL="mysql://usuario:senha@host:porta/banco"

# Integração com a Meta (WhatsApp oficial + Anúncios) — App criado em developers.facebook.com,
# produto "Login do Facebook para Empresas". META_APP_ID/META_APP_SECRET = credenciais desse App
# (Configurações do app > Básico). META_WEBHOOK_VERIFY_TOKEN = valor escolhido por você, cadastrado
# igual na configuração de Webhooks do App na Meta (WhatsApp e Instagram usam o mesmo valor).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Embedded Signup v4 — o popup da Meta que conecta o WhatsApp Business de cada cliente sem sair do
# CRM. Roda no navegador (SDK JS do Facebook), por isso `NEXT_PUBLIC_`. NEXT_PUBLIC_META_CONFIG_ID
# é o id da configuração do "Login do Facebook para Empresas" (App > Login do Facebook para
# Empresas > Configurações) — é ele que define quais permissões e qual fluxo o popup apresenta;
# sem ele o Embedded Signup não roda no modo certo. NEXT_PUBLIC_META_APP_ID é o mesmo META_APP_ID
# acima (app id não é segredo, aparece na URL do diálogo de qualquer jeito).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v23.0

# Segredo do Vercel Cron — protege a rota de verificação diária de saúde das conexões oficiais
# (/api/integracoes/meta/whatsapp/saude), que roda sem usuário logado. Qualquer string aleatória
# longa (`openssl rand -hex 32`); a Vercel manda ela como `Authorization: Bearer` nos crons.
CRON_SECRET=

# Instagram usa um produto separado da Meta — "API do Instagram com Login do Instagram" — com
# credenciais PRÓPRIAS, diferentes do App principal acima (aparecem em Casos de uso > API do
# Instagram > Configuração da API com login do Instagram, dentro do mesmo App da Meta).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# WhatsApp não oficial (QR Code) via Evolution API — servidor próprio (Baileys por trás de uma API
# REST), fora da Vercel. EVOLUTION_API_URL = endereço do servidor; EVOLUTION_API_KEY = chave global
# de administração dele (aba Variables do serviço, AUTHENTICATION_API_KEY). APP_URL precisa estar
# preenchido e acessível publicamente — é pra onde a Evolution manda os eventos de webhook.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
APP_URL=http://localhost:3000

# Assinatura do CRM via Asaas (cobrança da mensalidade do workspace, não é integração de cliente).
# ASAAS_ENV = "sandbox" (padrão, chave começa com $aact_hmlg_) ou "production" (chave $aact_prod_).
# ASAAS_API_KEY = chave de API gerada em asaas.com > Integrações > API.
# ASAAS_WALLET_ID = id da carteira Asaas (não usado nas chamadas atuais, guardado pra split de
#   pagamento futuro, se vier a existir).
# ASAAS_WEBHOOK_TOKEN = valor escolhido por você, cadastrado igual em Configurações > Integrações >
#   Webhooks no painel da Asaas — a Asaas devolve esse valor no header `asaas-access-token` de todo
#   webhook, é assim que a rota confirma que a chamada é mesmo da Asaas.
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_TOKEN="escolha-um-valor-aleatorio-longo"

# E-mail transacional da plataforma (recuperação de senha, ver src/lib/email.ts) — via Resend.
# RESEND_API_KEY = chave gerada em resend.com > API Keys.
# EMAIL_FROM = remetente ("Nome <endereco@dominio>"); sem domínio verificado no Resend, use
#   "CRM AZUZ <onboarding@resend.dev>" (funciona de graça, só não deixa customizar o domínio).
RESEND_API_KEY=""
EMAIL_FROM="CRM AZUZ <onboarding@resend.dev>"

# Painel de super-admin (/admin) — visão cross-tenant de todos os workspaces, uso interno da Azuz.
# SUPERADMIN_EMAIL = e-mail de um Membro que já existe em algum workspace (a senha continua sendo a
#   dele, cadastrada normalmente) — ao logar com esse e-mail, cai direto no /admin em vez do painel
#   normal do workspace. Só um e-mail; qualquer outro Membro continua vendo só o próprio workspace.
SUPERADMIN_EMAIL="thaynaraaraujosc@gmail.com"
