# Mesmo valor cadastrado na env WORKER_SECRET do projeto Next.js (Vercel) — autentica as chamadas
# nos dois sentidos (Next.js -> worker e worker -> Next.js).
WORKER_SECRET="escolha-um-valor-aleatorio-longo"

# URL pública do CRM (Vercel) — pra onde o worker manda as mensagens recebidas via webhook.
NEXTJS_BASE_URL="https://azuzcrm.com.br"

# Porta HTTP do próprio worker (Railway injeta PORT automaticamente em produção).
PORT=3333

# Pasta onde as credenciais de sessão do WhatsApp (por workspace) ficam salvas em disco — no
# Railway, deve apontar pra dentro de um volume persistente, senão a sessão se perde a cada deploy.
SESSOES_DIR="./sessoes"
